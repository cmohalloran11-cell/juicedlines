# secrets / credentials — NEVER COMMIT
# config.json is legacy/unused (PrizePicks is now cookie-free) but stays ignored so
# any stray local secret in it can never be committed. Real secrets → env / .env.
config.json
.env
*.key
secrets.json

# runtime data / databases (regenerated at runtime)
history.db
*.db
*.sqlite
*.sqlite3

# cached Sackmann-mirror CSVs (CC NON-COMMERCIAL — runtime cache, do not distribute)
tennis/data/cache/

# cached nflverse release CSVs (runtime cache, tens of MB — NFL_CACHE_DIR relocates it)
data/nfl_cache/

# static build artifact (the GitHub Action rebuilds it and pushes it to the deploy branch)
static/board.json
static/board.free.json
static/board.premium.json
static/analytics.json
static/history.json
static/clv.db
static/trust.json
# SPA page payloads — prebuilt by build_static.py, published to the deploy branch, read by
# the static frontend in place of /api/*. Same deal as board.json: artifacts, not source.
static/dashboard.json
static/projections.json
static/boosted.json
static/direction_report.json
static/injuries.json
static/weather.json
static/books.json
static/auth.json
static/model_health.json
static/backtest.json
static/drift.json
static/optimizer.json
static/optimizer_books.json
static/optimizer_mlb.json
static/optimizer_wnba.json
static/optimizer_tennis.json
static/optimizer_underdog.json
static/optimizer_sleeper.json
# clv_seed.db IS committed on purpose — it bootstraps the Action's ledger with the
# already-graded rows (the edge-regression asset). Without it the first Action run starts
# empty, publishes an empty ledger, and every later run then prefers that empty data-branch
# copy over the seed — orphaning the graded history permanently. The `*.db` rule above
# would swallow it, so re-include it explicitly.
!clv_seed.db

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# os / editor / tooling
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
